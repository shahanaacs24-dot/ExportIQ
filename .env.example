# ExportIQ Environment Variables
# Copy to .env and fill in real values — never commit .env

# ── Application ─────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://exportiq:exportiq_pass@localhost:5432/exportiq_db
ASYNC_DATABASE_URL=postgresql+asyncpg://exportiq:exportiq_pass@localhost:5432/exportiq_db

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff

# ── Optional LLM (leave blank to disable) ───────────────────
LLM_PROVIDER=
ANTHROPIC_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Postgres (for Docker Compose) ────────────────────────────
POSTGRES_USER=exportiq
POSTGRES_PASSWORD=exportiq_pass
POSTGRES_DB=exportiq_db
